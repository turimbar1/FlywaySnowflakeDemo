view "PUBLIC"."V_PRODUCT_SALES" {
  body = """-

SELECT
    p.PRODUCT_ID,
    p.SKU,
    p.PRODUCT_NAME,
    pc.CATEGORY_NAME,
    p.IS_ACTIVE,
    COALESCE(SUM(s.QUANTITY), 0)                                                          AS UNITS_SOLD,
    ROUND(COALESCE(SUM(s.QUANTITY * s.UNIT_PRICE * (1 - s.DISCOUNT_PCT)), 0), 2)          AS NET_REVENUE,
    ROUND(COALESCE(SUM(s.QUANTITY * (s.UNIT_PRICE * (1 - s.DISCOUNT_PCT) - p.UNIT_COST)), 0), 2) AS GROSS_MARGIN
FROM PRODUCTS p
JOIN PRODUCT_CATEGORIES pc ON pc.CATEGORY_ID = p.CATEGORY_ID
LEFT JOIN (
    SELECT oi.PRODUCT_ID, oi.QUANTITY, oi.UNIT_PRICE, oi.DISCOUNT_PCT
    FROM ORDER_ITEMS oi
    JOIN ORDERS o ON o.ORDER_ID = oi.ORDER_ID
    WHERE o.STATUS <> 'CANCELLED'
) s ON s.PRODUCT_ID = p.PRODUCT_ID
GROUP BY p.PRODUCT_ID, p.SKU, p.PRODUCT_NAME, pc.CATEGORY_NAME, p.IS_ACTIVE;
"""
}

